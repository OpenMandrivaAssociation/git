+#include "loose.hpp"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+namespace git {
+
+namespace {
+
+void append_be32(std::vector<std::uint8_t> &out, std::uint32_t v)
+{
+	out.push_back(static_cast<std::uint8_t>((v >> 24) & 0xff));
+	out.push_back(static_cast<std::uint8_t>((v >> 16) & 0xff));
+	out.push_back(static_cast<std::uint8_t>((v >> 8) & 0xff));
+	out.push_back(static_cast<std::uint8_t>(v & 0xff));
+}
+
+void append_be64(std::vector<std::uint8_t> &out, std::uint64_t v)
+{
+	for (int i = 7; i >= 0; i--)
+		out.push_back(static_cast<std::uint8_t>((v >> (i * 8)) & 0xff));
+}
+
+void append_bytes(std::vector<std::uint8_t> &out, const unsigned char *p,
+		  std::size_t n)
+{
+	out.insert(out.end(), p, p + n);
+}
+
+std::uint64_t required_nul_padding(std::size_t nitems, std::size_t short_len)
+{
+	const std::uint64_t shortened =
+		static_cast<std::uint64_t>(nitems) * short_len;
+	return (4 - (shortened & 3)) & 3;
+}
+
+std::size_t last_matching_offset(const object_id &a, const object_id &b,
+				 std::size_t rawsz)
+{
+	for (std::size_t i = 0; i <= rawsz; i++) {
+		if (a.hash[i] != b.hash[i])
+			return i;
+	}
+	return rawsz;
+}
+
+std::size_t find_short_name_len(const std::map<object_id, MappedObject> &map,
+				std::size_t rawsz)
+{
+	if (map.size() <= 1)
+		return 1;
+	std::size_t len = 1;
+	auto it = map.begin();
+	const object_id *cur = &it->first;
+	++it;
+	for (; it != map.end(); ++it) {
+		const std::size_t offset =
+			last_matching_offset(*cur, it->first, rawsz);
+		if (offset >= len)
+			len = offset + 1;
+		cur = &it->first;
+	}
+	return len > rawsz ? rawsz : len;
+}
+
+// Algorithm id stored in object_id.algo / hash_algos index.
+std::uint32_t algo_id(const git_hash_algo *algop)
+{
+	for (std::uint32_t i = 0; i < GIT_HASH_NALGOS; i++) {
+		if (&hash_algos[i] == algop)
+			return i;
+	}
+	return GIT_HASH_UNKNOWN;
+}
+
+} // namespace
+
+void ObjectMap::MemoryMap::write(std::vector<std::uint8_t> &out) const
+{
+	constexpr std::uint32_t VERSION_NUMBER = 1;
+	constexpr std::uint32_t NUM_OBJECT_FORMATS = 2;
+	const std::uint32_t header_size =
+		(4 * 5) + (4 + 4 + 8) * NUM_OBJECT_FORMATS + 8;
+
+	out.clear();
+	out.reserve(header_size + to_compat.size() * 64);
+	out.push_back('L');
+	out.push_back('M');
+	out.push_back('A');
+	out.push_back('P');
+	append_be32(out, VERSION_NUMBER);
+	append_be32(out, header_size);
+	append_be32(out, static_cast<std::uint32_t>(to_compat.size()));
+	append_be32(out, NUM_OBJECT_FORMATS);
+
+	const std::size_t storage_short_len =
+		find_short_name_len(to_compat, storage->rawsz);
+	const std::size_t compat_short_len =
+		find_short_name_len(to_storage, compat->rawsz);
+	const std::uint64_t storage_npadding =
+		required_nul_padding(to_compat.size(), storage_short_len);
+	const std::uint64_t compat_npadding =
+		required_nul_padding(to_compat.size(), compat_short_len);
+
+	std::uint64_t offset = header_size;
+	const git_hash_algo *algos[2] = {storage, compat};
+	const std::size_t lens[2] = {storage_short_len, compat_short_len};
+	const std::uint64_t npads[2] = {storage_npadding, compat_npadding};
+
+	for (int i = 0; i < 2; i++) {
+		append_be32(out, algos[i]->format_id);
+		append_be32(out, static_cast<std::uint32_t>(lens[i]));
+		offset += npads[i];
+		append_be64(out, offset);
+		offset += static_cast<std::uint64_t>(to_compat.size()) *
+			  (lens[i] + algos[i]->rawsz + 4);
+	}
+	append_be64(out, offset);
+
+	std::map<object_id, std::size_t> order_map;
+	std::size_t idx = 0;
+	for (const auto &kv : to_compat)
+		order_map.emplace(kv.first, idx++);
+
+	for (std::uint64_t i = 0; i < storage_npadding; i++)
+		out.push_back(0);
+	for (const auto &kv : to_compat)
+		append_bytes(out, kv.first.hash, storage_short_len);
+	for (const auto &kv : to_compat)
+		append_bytes(out, kv.first.hash, storage->rawsz);
+	for (const auto &kv : to_compat)
+		append_be32(out, static_cast<std::uint32_t>(kv.second.kind));
+
+	for (std::uint64_t i = 0; i < compat_npadding; i++)
+		out.push_back(0);
+	for (const auto &kv : to_storage)
+		append_bytes(out, kv.first.hash, compat_short_len);
+	for (const auto &kv : to_compat)
+		append_bytes(out, kv.second.oid.hash, compat->rawsz);
+	for (const auto &kv : to_storage) {
+		const auto it = order_map.find(kv.second.oid);
+		append_be32(out, it == order_map.end()
+					 ? 0
+					 : static_cast<std::uint32_t>(it->second));
+	}
+}
+
+void ObjectMap::insert_into(MemoryMap &map, const object_id &storage,
+			    const object_id &compat, MapType kind)
+{
+	map.to_compat[storage] = MappedObject{compat, kind};
+	map.to_storage[compat] = MappedObject{storage, kind};
+}
+
+ObjectMap::ObjectMap(const git_hash_algo *storage, const git_hash_algo *compat)
+	: storage_(storage)
+	, compat_(compat)
+	, mem_(storage, compat)
+{
+	if (!storage_ || !compat_)
+		throw std::invalid_argument("null hash algorithm");
+
+	const object_id *pairs[][2] = {
+		{storage_->empty_tree, compat_->empty_tree},
+		{storage_->empty_blob, compat_->empty_blob},
+		{storage_->null_oid, compat_->null_oid},
+	};
+	for (auto &pair : pairs)
+		insert_into(mem_, *pair[0], *pair[1], MapType::Reserved);
+}
+
+void ObjectMap::start_batch()
+{
+	if (!batch_)
+		batch_ = MemoryMap(storage_, compat_);
+}
+
+std::optional<std::size_t> ObjectMap::batch_len() const
+{
+	if (!batch_)
+		return std::nullopt;
+	return batch_->len();
+}
+
+void ObjectMap::finish_batch(std::vector<std::uint8_t> &out)
+{
+	if (!batch_)
+		return;
+	batch_->write(out);
+	batch_.reset();
+}
+
+void ObjectMap::abort_batch()
+{
+	batch_.reset();
+}
+
+void ObjectMap::insert(const object_id &oid1, const object_id &oid2, MapType kind,
+		       bool write)
+{
+	const object_id *compat_oid;
+	const object_id *storage_oid;
+	if (hash_algo(oid1.algo) == compat_) {
+		compat_oid = &oid1;
+		storage_oid = &oid2;
+	} else {
+		compat_oid = &oid2;
+		storage_oid = &oid1;
+	}
+	insert_into(mem_, *storage_oid, *compat_oid, kind);
+	if (write && batch_)
+		insert_into(*batch_, *storage_oid, *compat_oid, kind);
+}
+
+std::optional<MappedObject>
+ObjectMap::map_object(const object_id &oid, const git_hash_algo *algo) const
+{
+	const auto &map = (algo == storage_) ? mem_.to_storage : mem_.to_compat;
+	const auto it = map.find(oid);
+	if (it == map.end())
+		return std::nullopt;
+	return it->second;
+}
+
+std::optional<object_id> ObjectMap::map_oid(const object_id &oid,
+					    const git_hash_algo *algo) const
+{
+	if (algo_id(algo) == oid.algo)
+		return oid;
+	const auto entry = map_object(oid, algo);
+	if (!entry)
+		return std::nullopt;
+	return entry->oid;
+}
+
+std::uint32_t MmapedObjectMap::u32_at(const std::uint8_t *p)
+{
+	return (static_cast<std::uint32_t>(p[0]) << 24) |
+	       (static_cast<std::uint32_t>(p[1]) << 16) |
+	       (static_cast<std::uint32_t>(p[2]) << 8) |
+	       static_cast<std::uint32_t>(p[3]);
+}
+
+std::uint64_t MmapedObjectMap::u64_at(const std::uint8_t *p)
+{
+	std::uint64_t v = 0;
+	for (int i = 0; i < 8; i++)
+		v = (v << 8) | p[i];
+	return v;
+}
+
+MmapedObjectMap::MmapedObjectMap(const std::uint8_t *data, std::size_t len,
+				 const git_hash_algo *hash_algo)
+	: memory_(data)
+	, memory_len_(len)
+	, main_algo_(hash_algo)
+{
+	if (!main_algo_)
+		throw std::invalid_argument("null hash algorithm");
+
+	constexpr std::size_t object_format_header_size = 4 + 4 + 8;
+	constexpr std::size_t trailer_offset_size = 8;
+	const std::size_t header_size = 4 + 4 + 4 + 4 + 4 +
+					object_format_header_size * 2 +
+					trailer_offset_size;
+
+	if (len < header_size)
+		throw ParseError("header too small");
+	if (std::memcmp(data, "LMAP", 4) != 0)
+		throw ParseError("invalid signature");
+	if (u32_at(data + 4) != 1)
+		throw ParseError("invalid version");
+
+	nitems_ = u32_at(data + 12);
+	const std::size_t nobj_formats = u32_at(data + 16);
+	if (nobj_formats < 2)
+		throw ParseError("too few object formats");
+
+	std::size_t offset = 20;
+	std::optional<std::size_t> meta_off;
+	for (std::size_t i = 0; i < nobj_formats; i++) {
+		if (offset + object_format_header_size + trailer_offset_size >
+		    len)
+			throw ParseError("header too small");
+		const std::uint32_t format_id = u32_at(data + offset);
+		const std::size_t shortened_len = u32_at(data + offset + 4);
+		const std::uint64_t data_off_u = u64_at(data + offset + 8);
+
+		const git_hash_algo *algo = hash_algo_by_format_id(format_id);
+		if (!algo)
+			throw ParseError("unknown algorithm");
+		if (data_off_u > len)
+			throw ParseError("offset too large");
+		const std::size_t data_off =
+			static_cast<std::size_t>(data_off_u);
+
+		if (shortened_len &&
+		    nitems_ > std::numeric_limits<std::size_t>::max() /
+				      shortened_len)
+			throw ParseError("offset too large");
+		const std::size_t shortened_table_len = shortened_len * nitems_;
+		const std::size_t full_off = data_off + shortened_table_len;
+		if ((full_off & 3) != 0)
+			throw ParseError("unaligned data");
+		if (full_off >= len)
+			throw ParseError("offset too large");
+
+		const std::size_t raw = algo->rawsz;
+		if (raw &&
+		    nitems_ > std::numeric_limits<std::size_t>::max() / raw)
+			throw ParseError("offset too large");
+		const std::size_t off = full_off + raw * nitems_;
+		if ((off & 3) != 0)
+			throw ParseError("unaligned data");
+		if (off >= len)
+			throw ParseError("offset too large");
+
+		if (nitems_ > std::numeric_limits<std::size_t>::max() / 4)
+			throw ParseError("offset too large");
+		if (off + nitems_ * 4 > len)
+			throw ParseError("offset too large");
+
+		ObjectFormatData ofd;
+		ofd.data_off = data_off;
+		ofd.shortened_len = shortened_len;
+		ofd.full_off = full_off;
+		if (i == 0)
+			meta_off = off;
+		else
+			ofd.mapping_off = off;
+
+		obj_formats_[algo_id(algo)] = ofd;
+		offset += object_format_header_size;
+	}
+
+	const std::uint64_t trailer = u64_at(data + offset);
+	if ((trailer & 3) != 0)
+		throw ParseError("unaligned data");
+	if (trailer >= len)
+		throw ParseError("offset too large");
+	if (trailer + main_algo_->rawsz != len)
+		throw ParseError("invalid trailer offset");
+	if (!meta_off)
+		throw ParseError("too few object formats");
+	meta_off_ = *meta_off;
+}
+
+std::optional<std::size_t>
+MmapedObjectMap::binary_search_slice(const std::uint8_t *sl, std::size_t sl_len,
+				     const std::uint8_t *wanted,
+				     std::size_t wanted_len)
+{
+	if (wanted_len == 0 || sl_len < wanted_len)
+		return std::nullopt;
+	const std::size_t n = sl_len / wanted_len;
+	std::size_t lo = 0, hi = n;
+	while (lo < hi) {
+		const std::size_t mid = lo + (hi - lo) / 2;
+		const int cmp =
+			std::memcmp(sl + mid * wanted_len, wanted, wanted_len);
+		if (cmp < 0)
+			lo = mid + 1;
+		else if (cmp > 0)
+			hi = mid;
+		else
+			return mid;
+	}
+	return std::nullopt;
+}
+
+std::optional<std::size_t>
+MmapedObjectMap::look_up_object(const object_id &oid) const
+{
+	const auto it = obj_formats_.find(oid.algo);
+	if (it == obj_formats_.end())
+		return std::nullopt;
+	const ObjectFormatData &params = it->second;
+	const git_hash_algo *oid_algo = hash_algo(oid.algo);
+	if (!oid_algo)
+		return std::nullopt;
+
+	const std::size_t short_table_len = params.shortened_len * nitems_;
+	if (params.data_off + short_table_len > memory_len_)
+		return std::nullopt;
+
+	const auto index = binary_search_slice(memory_ + params.data_off,
+					       short_table_len, oid.hash,
+					       params.shortened_len);
+	if (!index)
+		return std::nullopt;
+
+	const std::size_t raw = oid_algo->rawsz;
+	if (params.mapping_off) {
+		const std::size_t mapped =
+			u32_at(memory_ + *params.mapping_off + *index * 4);
+		if (mapped >= nitems_)
+			return std::nullopt;
+		const std::size_t oid_offset = params.full_off + mapped * raw;
+		if (oid_offset + raw > memory_len_)
+			return std::nullopt;
+		if (std::memcmp(memory_ + oid_offset, oid.hash, raw) != 0)
+			return std::nullopt;
+		return mapped;
+	}
+
+	const std::size_t oid_offset = params.full_off + *index * raw;
+	if (oid_offset + raw > memory_len_)
+		return std::nullopt;
+	if (std::memcmp(memory_ + oid_offset, oid.hash, raw) != 0)
+		return std::nullopt;
+	return *index;
+}
+
+std::optional<object_id>
+MmapedObjectMap::oid_from_offset(std::size_t offset,
+				 const git_hash_algo *algo) const
+{
+	const auto it = obj_formats_.find(algo_id(algo));
+	if (it == obj_formats_.end())
+		return std::nullopt;
+	const ObjectFormatData &aparams = it->second;
+	const std::size_t len = algo->rawsz;
+	const std::size_t oid_off = aparams.full_off + offset * len;
+	if (oid_off + len > memory_len_)
+		return std::nullopt;
+	object_id oid{};
+	oid.algo = algo_id(algo);
+	std::memcpy(oid.hash, memory_ + oid_off, len);
+	return oid;
+}
+
+std::optional<MappedObject>
+MmapedObjectMap::map_object(const object_id &oid,
+			    const git_hash_algo *algo) const
+{
+	const auto main = look_up_object(oid);
+	if (!main)
+		return std::nullopt;
+	if (meta_off_ + *main * 4 + 4 > memory_len_)
+		return std::nullopt;
+	const std::uint32_t kind_u = u32_at(memory_ + meta_off_ + *main * 4);
+	MapType meta;
+	switch (kind_u) {
+	case 0:
+		meta = MapType::Reserved;
+		break;
+	case 1:
+		meta = MapType::LooseObject;
+		break;
+	case 2:
+		meta = MapType::Shallow;
+		break;
+	case 3:
+		meta = MapType::Submodule;
+		break;
+	default:
+		return std::nullopt;
+	}
+	const auto mapped_oid = oid_from_offset(*main, algo);
+	if (!mapped_oid)
+		return std::nullopt;
+	return MappedObject{*mapped_oid, meta};
+}
+
+std::optional<object_id>
+MmapedObjectMap::map_oid(const object_id &oid, const git_hash_algo *algo) const
+{
+	if (algo_id(algo) == oid.algo)
+		return oid;
+	const auto main = look_up_object(oid);
+	if (!main)
+		return std::nullopt;
+	return oid_from_offset(*main, algo);
+}
+
+} // namespace git
