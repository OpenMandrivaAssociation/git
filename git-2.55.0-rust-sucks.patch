+// with this program; if not, see <https://www.gnu.org/licenses/>.
+
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+
+// Decode the variable-length integer stored in *bufp and return the decoded
+// value. Returns 0 if the decoded integer would overflow uint64_t.
+// The buffer must be NUL-terminated to ensure safety.
+uint64_t decode_varint(const unsigned char **bufp)
+{
+	const unsigned char *buf = *bufp;
+	unsigned char c = *buf++;
+	uint64_t val = c & 127;
+
+	while (c & 128) {
+		val += 1;
+		// Overflow if val wrapped to 0 or the top 7 bits are non-zero
+		// (would shift out data on the next step).
+		if (!val || (val >> 57) != 0)
+			return 0;
+		c = *buf++;
+		val = (val << 7) + (c & 127);
+	}
+
+	*bufp = buf;
+	return val;
+}
+
+// Encode value into buf as a variable-length integer unless buf is null.
+// Returns the number of bytes written, or, if buf is null, the number of
+// bytes that would be written. buf must either be null or point to at least
+// 16 bytes of memory.
+uint8_t encode_varint(uint64_t value, unsigned char *buf)
+{
+	unsigned char varint[16];
+	unsigned pos = sizeof(varint) - 1;
+
+	varint[pos] = value & 127;
+	value >>= 7;
+	while (value != 0) {
+		pos -= 1;
+		value -= 1;
+		varint[pos] = 128 | (value & 127);
+		value >>= 7;
+	}
+
+	if (buf)
+		memcpy(buf, varint + pos, sizeof(varint) - pos);
+
+	return static_cast<uint8_t>(sizeof(varint) - pos);
+}
+
+} // extern "C"
