-    fn map_oid(&self, oid: &ObjectID, algo: HashAlgorithm) -> Option<ObjectID> {
-        if algo as u32 == oid.algo {
-            return Some(oid.clone());
-        }
-
-        let main = self.look_up_object(oid)?;
-        self.oid_from_offset(main, algo)
