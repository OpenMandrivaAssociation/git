+// Loose-object ID map (storage <-> compatibility) and LMAP binary format.
+
+#ifndef GIT_SRC_LOOSE_HPP
+#define GIT_SRC_LOOSE_HPP
+
+#include "git_c.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <stdexcept>
+#include <vector>
+
+namespace git {
+
+enum class MapType : std::uint32_t {
+	Reserved = 0,
+	LooseObject = 1,
+	Shallow = 2,
+	Submodule = 3,
+};
+
+struct MappedObject {
+	object_id oid{};
+	MapType kind = MapType::Reserved;
+};
+
+class ObjectMap {
+public:
+	ObjectMap(const git_hash_algo *storage, const git_hash_algo *compat);
+
+	[[nodiscard]] const git_hash_algo *storage_algo() const noexcept
+	{
+		return storage_;
+	}
+	[[nodiscard]] const git_hash_algo *compat_algo() const noexcept
+	{
+		return compat_;
+	}
+
+	void start_batch();
+	[[nodiscard]] std::optional<std::size_t> batch_len() const;
+	void finish_batch(std::vector<std::uint8_t> &out);
+	void abort_batch();
+	[[nodiscard]] bool has_batch() const noexcept { return batch_.has_value(); }
+
+	void insert(const object_id &oid1, const object_id &oid2, MapType kind,
+		    bool write);
+
+	[[nodiscard]] std::optional<MappedObject>
+	map_object(const object_id &oid, const git_hash_algo *algo) const;
+	[[nodiscard]] std::optional<object_id>
+	map_oid(const object_id &oid, const git_hash_algo *algo) const;
+
+private:
+	struct MemoryMap {
+		std::map<object_id, MappedObject> to_compat;
+		std::map<object_id, MappedObject> to_storage;
+		const git_hash_algo *compat = nullptr;
+		const git_hash_algo *storage = nullptr;
+
+		MemoryMap(const git_hash_algo *storage_algo,
+			  const git_hash_algo *compat_algo)
+			: compat(compat_algo)
+			, storage(storage_algo)
+		{
+		}
+
+		[[nodiscard]] std::size_t len() const { return to_compat.size(); }
+		void write(std::vector<std::uint8_t> &out) const;
+	};
+
+	static void insert_into(MemoryMap &map, const object_id &storage,
+				const object_id &compat, MapType kind);
+
+	const git_hash_algo *storage_;
+	const git_hash_algo *compat_;
+	MemoryMap mem_;
+	std::optional<MemoryMap> batch_;
+};
+
+class MmapedObjectMap {
+public:
+	class ParseError : public std::runtime_error {
+	public:
+		using std::runtime_error::runtime_error;
+	};
+
+	MmapedObjectMap(const std::uint8_t *data, std::size_t len,
+			const git_hash_algo *hash_algo);
+
+	[[nodiscard]] std::optional<object_id>
+	map_oid(const object_id &oid, const git_hash_algo *algo) const;
+	[[nodiscard]] std::optional<MappedObject>
+	map_object(const object_id &oid, const git_hash_algo *algo) const;
+
+	[[nodiscard]] static std::optional<std::size_t>
+	binary_search_slice(const std::uint8_t *sl, std::size_t sl_len,
+			    const std::uint8_t *wanted, std::size_t wanted_len);
+
+private:
+	struct ObjectFormatData {
+		std::size_t data_off = 0;
+		std::size_t shortened_len = 0;
+		std::size_t full_off = 0;
+		std::optional<std::size_t> mapping_off;
+	};
+
+	[[nodiscard]] std::optional<std::size_t>
+	look_up_object(const object_id &oid) const;
+	[[nodiscard]] std::optional<object_id>
+	oid_from_offset(std::size_t offset, const git_hash_algo *algo) const;
+
+	static std::uint32_t u32_at(const std::uint8_t *p);
+	static std::uint64_t u64_at(const std::uint8_t *p);
+
+	const std::uint8_t *memory_;
+	std::size_t memory_len_;
+	std::size_t nitems_ = 0;
+	std::size_t meta_off_ = 0;
+	// Keyed by algorithm id (GIT_HASH_SHA1 / GIT_HASH_SHA256).
+	std::map<std::uint32_t, ObjectFormatData> obj_formats_;
+	const git_hash_algo *main_algo_;
+};
+
+} // namespace git
+
+#endif /* GIT_SRC_LOOSE_HPP */
