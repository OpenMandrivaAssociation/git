@@ -0,0 +1,103 @@
+// RAII wrapper for Git's checksummed file writer (csum-file.h).
+
+#ifndef GIT_SRC_CSUM_FILE_HPP
+#define GIT_SRC_CSUM_FILE_HPP
+
+#include "git_c.hpp"
+
+#include <algorithm>
+#include <limits>
+#include <span>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace git {
+
+class HashFile {
+public:
+	HashFile(const git_hash_algo *algop, int fd, const char *name)
+		: algop_(algop)
+		, file_(make_hashfile(algop, fd, name))
+	{
+		if (!algop_)
+			throw std::invalid_argument("null hash algorithm");
+		if (!file_)
+			throw std::runtime_error("hashfd failed");
+	}
+
+	HashFile(std::uint32_t algo_id, int fd, const char *name)
+		: HashFile(require_hash_algo(algo_id), fd, name)
+	{
+	}
+
+	HashFile(const HashFile &) = delete;
+	HashFile &operator=(const HashFile &) = delete;
+	HashFile(HashFile &&) noexcept = default;
+	HashFile &operator=(HashFile &&) noexcept = default;
+	~HashFile() = default; // HashfilePtr runs free_hashfile if still owned
+
+	[[nodiscard]] const git_hash_algo *algorithm() const noexcept
+	{
+		return algop_;
+	}
+
+	[[nodiscard]] bool alive() const noexcept
+	{
+		return static_cast<bool>(file_);
+	}
+
+	void write(const void *data, std::size_t len)
+	{
+		ensure_live();
+		const auto *p = static_cast<const unsigned char *>(data);
+		while (len > 0) {
+			const auto chunk = static_cast<std::uint32_t>(
+				std::min(len, static_cast<std::size_t>(
+						      std::numeric_limits<std::uint32_t>::max())));
+			hashwrite(file_.get(), p, chunk);
+			p += chunk;
+			len -= chunk;
+		}
+	}
+
+	void write(std::span<const std::uint8_t> data)
+	{
+		write(data.data(), data.size());
+	}
+
+	void flush()
+	{
+		ensure_live();
+		hashflush(file_.get());
+	}
+
+	// Flush, write trailing checksum as configured by flags, free the
+	// hashfile, and return the digest (algop->rawsz bytes).
+	[[nodiscard]] std::vector<std::uint8_t>
+	finalize(unsigned /* enum fsync_component */ component = 0,
+		 unsigned flags = 0)
+	{
+		ensure_live();
+		std::vector<std::uint8_t> result(GIT_MAX_RAWSZ);
+		// finalize_hashfile consumes and frees the hashfile.
+		hashfile *raw = file_.release();
+		finalize_hashfile(raw, result.data(), component, flags);
+		result.resize(algop_->rawsz);
+		return result;
+	}
+
+private:
+	void ensure_live() const
+	{
+		if (!file_)
+			throw std::logic_error("HashFile used after finalize");
+	}
+
+	const git_hash_algo *algop_ = nullptr;
+	HashfilePtr file_;
+};
+
+} // namespace git
+
+#endif /* GIT_SRC_CSUM_FILE_HPP */
