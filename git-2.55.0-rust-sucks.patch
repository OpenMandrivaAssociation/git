@@ -0,0 +1,125 @@
+// RAII hashing helpers over Git's C hash API (hash.h).
+
+#ifndef GIT_SRC_HASH_HPP
+#define GIT_SRC_HASH_HPP
+
+#include "git_c.hpp"
+
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace git {
+
+// Cryptographic hasher owning a git_hash_ctx.
+class CryptoHasher {
+public:
+	explicit CryptoHasher(const git_hash_algo *algop)
+		: algop_(algop)
+		, ctx_(make_git_hash_ctx(algop))
+	{
+		if (!algop_)
+			throw std::invalid_argument("null hash algorithm");
+	}
+
+	explicit CryptoHasher(std::uint32_t algo_id)
+		: CryptoHasher(require_hash_algo(algo_id))
+	{
+	}
+
+	CryptoHasher(const CryptoHasher &other)
+		: algop_(other.algop_)
+		, ctx_(git_hash_alloc())
+	{
+		git_hash_clone(ctx_.get(), other.ctx_.get());
+	}
+
+	CryptoHasher &operator=(const CryptoHasher &other)
+	{
+		if (this == &other)
+			return *this;
+		CryptoHasher copy(other);
+		swap(copy);
+		return *this;
+	}
+
+	CryptoHasher(CryptoHasher &&) noexcept = default;
+	CryptoHasher &operator=(CryptoHasher &&) noexcept = default;
+	~CryptoHasher() = default;
+
+	void swap(CryptoHasher &other) noexcept
+	{
+		std::swap(algop_, other.algop_);
+		ctx_.swap(other.ctx_);
+	}
+
+	[[nodiscard]] const git_hash_algo *algorithm() const noexcept
+	{
+		return algop_;
+	}
+
+	// Safe for untrusted data (uses collision-detecting SHA-1 when built in).
+	[[nodiscard]] static constexpr bool is_safe() noexcept { return true; }
+
+	void update(const void *data, std::size_t len)
+	{
+		ensure_live();
+		git_hash_update(ctx_.get(), data, len);
+	}
+
+	void update(std::span<const std::uint8_t> data)
+	{
+		update(data.data(), data.size());
+	}
+
+	// Consume the hasher and return the object id.
+	[[nodiscard]] object_id finish_oid()
+	{
+		ensure_live();
+		object_id oid{};
+		git_hash_final_oid(&oid, ctx_.get());
+		ctx_.reset();
+		return oid;
+	}
+
+	// Consume the hasher and return raw hash bytes (algop->rawsz long).
+	[[nodiscard]] std::vector<std::uint8_t> finish_raw()
+	{
+		ensure_live();
+		std::vector<std::uint8_t> out(algop_->rawsz);
+		git_hash_final(out.data(), ctx_.get());
+		ctx_.reset();
+		return out;
+	}
+
+	[[nodiscard]] bool alive() const noexcept { return static_cast<bool>(ctx_); }
+
+private:
+	void ensure_live() const
+	{
+		if (!ctx_)
+			throw std::logic_error("CryptoHasher used after finish");
+	}
+
+	const git_hash_algo *algop_ = nullptr;
+	GitHashCtxPtr ctx_;
+};
+
+[[nodiscard]] inline std::string oid_to_hex(const object_id &oid)
+{
+	const git_hash_algo *algop = hash_algo(oid.algo);
+	const std::size_t n = algop ? algop->rawsz : GIT_MAX_RAWSZ;
+	std::string out(n * 2, '\0');
+	static constexpr char hex[] = "0123456789abcdef";
+	for (std::size_t i = 0; i < n; i++) {
+		out[i * 2] = hex[oid.hash[i] >> 4];
+		out[i * 2 + 1] = hex[oid.hash[i] & 0xf];
+	}
+	return out;
+}
+
+} // namespace git
+
+#endif /* GIT_SRC_HASH_HPP */
