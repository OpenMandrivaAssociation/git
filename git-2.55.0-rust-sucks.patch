diff --git a/src/git_c.hpp b/src/git_c.hpp
new file mode 100644
index 0000000..4771b93
--- /dev/null
+++ b/src/git_c.hpp
@@ -0,0 +1,176 @@
+// C API surface used by the C++ gitcore library.
+//
+// Git's public headers pull in git-compat-util.h and are not C++-clean, so we
+// cannot #include them from C++ translation units.  The types and entry points
+// below are kept in lockstep with hash.h / csum-file.h / varint.h and link
+// against the same symbols in libgit.a.
+
+#ifndef GIT_SRC_GIT_C_HPP
+#define GIT_SRC_GIT_C_HPP
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+// Match hash.h constants.
+inline constexpr unsigned GIT_HASH_UNKNOWN = 0;
+inline constexpr unsigned GIT_HASH_SHA1 = 1;
+inline constexpr unsigned GIT_HASH_SHA256 = 2;
+inline constexpr unsigned GIT_HASH_NALGOS = GIT_HASH_SHA256 + 1;
+
+inline constexpr std::uint32_t GIT_SHA1_FORMAT_ID = 0x73686131;
+inline constexpr std::uint32_t GIT_SHA256_FORMAT_ID = 0x73323536;
+
+inline constexpr std::size_t GIT_SHA1_RAWSZ = 20;
+inline constexpr std::size_t GIT_SHA256_RAWSZ = 32;
+inline constexpr std::size_t GIT_MAX_RAWSZ = GIT_SHA256_RAWSZ;
+
+// Match csum-file.h finalize_hashfile flags / fsync_component usage.
+// Values for enum fsync_component are only passed through; callers may use 0.
+inline constexpr unsigned CSUM_CLOSE = 1;
+inline constexpr unsigned CSUM_FSYNC = 2;
+inline constexpr unsigned CSUM_HASH_IN_STREAM = 4;
+
+extern "C" {
+
+struct object_id {
+	unsigned char hash[GIT_MAX_RAWSZ];
+	std::uint32_t algo;
+};
+
+struct git_hash_ctx; // incomplete; only used via git_hash_alloc/free
+struct hashfile;     // incomplete; only used via hashfd / free_hashfile
+
+// Layout must match hash.h (verified against libgit.a).
+struct git_hash_algo {
+	const char *name;
+	std::uint32_t format_id;
+	std::size_t rawsz;
+	std::size_t hexsz;
+	std::size_t blksz;
+	void (*init_fn)(struct git_hash_ctx *);
+	void (*clone_fn)(struct git_hash_ctx *, const struct git_hash_ctx *);
+	void (*update_fn)(struct git_hash_ctx *, const void *, std::size_t);
+	void (*final_fn)(unsigned char *, struct git_hash_ctx *);
+	void (*final_oid_fn)(struct object_id *, struct git_hash_ctx *);
+	const struct object_id *empty_tree;
+	const struct object_id *empty_blob;
+	const struct object_id *null_oid;
+	const struct git_hash_algo *unsafe;
+};
+
+// Hashing (hash.h)
+void git_hash_init(struct git_hash_ctx *ctx, const struct git_hash_algo *algop);
+void git_hash_clone(struct git_hash_ctx *dst, const struct git_hash_ctx *src);
+void git_hash_update(struct git_hash_ctx *ctx, const void *in, std::size_t len);
+void git_hash_final(unsigned char *hash, struct git_hash_ctx *ctx);
+void git_hash_final_oid(struct object_id *oid, struct git_hash_ctx *ctx);
+const struct git_hash_algo *hash_algo_ptr_by_number(std::uint32_t algo);
+struct git_hash_ctx *git_hash_alloc(void);
+void git_hash_free(struct git_hash_ctx *ctx);
+const struct object_id *null_oid(const struct git_hash_algo *algop);
+
+extern const struct git_hash_algo hash_algos[GIT_HASH_NALGOS];
+
+// Checksummed files (csum-file.h)
+struct hashfile *hashfd(const struct git_hash_algo *algop, int fd,
+			const char *name);
+void free_hashfile(struct hashfile *f);
+int finalize_hashfile(struct hashfile *f, unsigned char *result,
+		      unsigned /* enum fsync_component */ component,
+		      unsigned flags);
+void hashwrite(struct hashfile *f, const void *data, std::uint32_t len);
+void hashflush(struct hashfile *f);
+
+// Varint (varint.h) — also implemented in this library.
+std::uint8_t encode_varint(std::uint64_t value, unsigned char *buf);
+std::uint64_t decode_varint(const unsigned char **bufp);
+
+} // extern "C"
+
+// --- RAII helpers -----------------------------------------------------------
+
+struct GitHashCtxDeleter {
+	void operator()(git_hash_ctx *ctx) const noexcept
+	{
+		if (ctx)
+			git_hash_free(ctx);
+	}
+};
+
+using GitHashCtxPtr = std::unique_ptr<git_hash_ctx, GitHashCtxDeleter>;
+
+inline GitHashCtxPtr make_git_hash_ctx(const git_hash_algo *algop)
+{
+	GitHashCtxPtr ctx(git_hash_alloc());
+	git_hash_init(ctx.get(), algop);
+	return ctx;
+}
+
+// Owns a hashfile until finalize() or explicit release.  On destroy without
+// finalize, frees without flushing (free_hashfile).
+struct HashfileDeleter {
+	void operator()(hashfile *f) const noexcept
+	{
+		if (f)
+			free_hashfile(f);
+	}
+};
+
+using HashfilePtr = std::unique_ptr<hashfile, HashfileDeleter>;
+
+inline HashfilePtr make_hashfile(const git_hash_algo *algop, int fd,
+				 const char *name)
+{
+	return HashfilePtr(hashfd(algop, fd, name));
+}
+
+// object_id utilities for use in associative containers.
+inline bool operator==(const object_id &a, const object_id &b) noexcept
+{
+	return a.algo == b.algo &&
+	       std::char_traits<unsigned char>::compare(a.hash, b.hash,
+							GIT_MAX_RAWSZ) == 0;
+}
+
+inline bool operator!=(const object_id &a, const object_id &b) noexcept
+{
+	return !(a == b);
+}
+
+inline bool operator<(const object_id &a, const object_id &b) noexcept
+{
+	if (a.algo != b.algo)
+		return a.algo < b.algo;
+	return std::char_traits<unsigned char>::compare(a.hash, b.hash,
+							GIT_MAX_RAWSZ) < 0;
+}
+
+inline const git_hash_algo *hash_algo(std::uint32_t id)
+{
+	if (id == GIT_HASH_UNKNOWN || id >= GIT_HASH_NALGOS)
+		return nullptr;
+	return &hash_algos[id];
+}
+
+inline const git_hash_algo *require_hash_algo(std::uint32_t id)
+{
+	const git_hash_algo *a = hash_algo(id);
+	if (!a)
+		throw std::invalid_argument("invalid hash algorithm id");
+	return a;
+}
+
+// Resolve by format id ("sha1" / "s256" fourcc), matching hash_algo_by_id.
+inline const git_hash_algo *hash_algo_by_format_id(std::uint32_t format_id)
+{
+	for (unsigned i = 1; i < GIT_HASH_NALGOS; i++) {
+		if (hash_algos[i].format_id == format_id)
+			return &hash_algos[i];
+	}
+	return nullptr;
+}
+
+#endif /* GIT_SRC_GIT_C_HPP */
