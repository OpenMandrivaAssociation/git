-    fn verify_valid(slice: &[u8], offset: u64) -> Result<(), MmapedParseError> {
-        if offset >= slice.len() as u64 {
-            return Err(MmapedParseError::OffsetTooLarge);
-        }
-        Ok(())
-    }
